pipeline {
  agent any

  environment {
    AWS_REGION = 'us-east-1'
    STACK_NAME = 'sample-vpc-3az'
    TEMPLATE   = 'infracft.yaml'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Validate Template') {
      steps {
        bat """
          aws cloudformation validate-template ^
            --region us-east-2 ^
            --template-body file://infracft.yaml
        """
      }
    }

    stage('Deploy Stack') {
      steps {
        bat """
          aws cloudformation deploy ^
            --region %AWS_REGION% ^
            --stack-name student-infra-pipeline ^
            --template-file infracft.yaml ^
            --capabilities CAPABILITY_NAMED_IAM
        """
      }
    }
  }
}
